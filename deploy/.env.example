# Copiar a deploy/.env en el servidor. No subir secretos a Git.
# Sólo el hostname, sin https:// ni barras. Debe resolver a la IP de la VM.
APP_HOST=demo.example.com

# Generar cada valor por separado: python3 -c 'import secrets; print(secrets.token_hex(32))'
# Usar contraseña hexadecimal para que sea segura dentro de DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-hex-password
CSRF_SECRET=replace-with-random-secret-at-least-32-characters

# S3-compatible, por ejemplo OCI Object Storage Always Free.
# Usar el endpoint de compatibilidad S3 de tu namespace y región.
S3_ENDPOINT_URL=https://replace-namespace.compat.objectstorage.replace-region.oraclecloud.com
S3_REGION=replace-region
S3_ACCESS_KEY=replace-with-customer-access-key
S3_SECRET_KEY=replace-with-customer-secret-key
S3_BUCKET=vista360-demo-private
S3_PUBLIC_BUCKET=vista360-demo-public
PUBLIC_MEDIA_BASE_URL=https://objectstorage.replace-region.oraclecloud.com/n/replace-namespace/b/vista360-demo-public/o

# Límites conservadores por estudio/cliente, sin activar planes de pago.
PLATFORM_ADMIN_USER_IDS=[]
ORGANIZATION_TOUR_LIMIT=5
ORGANIZATION_MEMBER_LIMIT=5
ORGANIZATION_STORAGE_QUOTA_BYTES=1073741824
TOUR_STORAGE_QUOTA_BYTES=536870912
OWNER_STORAGE_QUOTA_BYTES=1073741824
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_WIDTH=16384
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=135000000

# Base comercial preparada; activar los límites sólo después de revisar cuotas y planes.
SUBSCRIPTION_LIMITS_ENABLED=false
SUBSCRIPTION_TRIAL_STORAGE_BYTES=268435456
SUBSCRIPTION_PROFESSIONAL_STORAGE_BYTES=2147483648
SUBSCRIPTION_STUDIO_STORAGE_BYTES=10737418240
