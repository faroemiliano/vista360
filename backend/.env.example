APP_NAME=Vista360 API
DATABASE_URL=postgresql+psycopg://vista360:replace-with-local-password@localhost:55433/vista360
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
APP_ENV=development
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local: API y worker deben compartir el mismo directorio.
STORAGE_BACKEND=local
# STORAGE_LOCAL_DIR=/ruta/absoluta/vista360/backend/.data/assets
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_WIDTH=16384
MAX_IMAGE_HEIGHT=8192
MAX_IMAGE_PIXELS=135000000
TOUR_STORAGE_QUOTA_BYTES=1073741824
OWNER_STORAGE_QUOTA_BYTES=5368709120
UPLOAD_TTL_SECONDS=600
WORKER_LEASE_SECONDS=300
IMAGE_PROCESSING_TIMEOUT_SECONDS=120

# Opcional: instalar el extra [s3] y configurar un bucket privado.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=vista360-private
# S3_REGION=auto
# S3_ACCESS_KEY=replace-with-private-access-key
# S3_SECRET_KEY=replace-with-private-secret-key
# Publicación: bucket separado para derivados, accesible por dominio/CDN.
# S3_PUBLIC_BUCKET=vista360-public
# PUBLIC_MEDIA_BASE_URL=https://media.example.com

# UUIDs explícitos de cuentas autorizadas por el operador; nunca emails.
PLATFORM_ADMIN_USER_IDS=[]
# Límites iniciales por organización nueva. No activan suscripciones.
ORGANIZATION_TOUR_LIMIT=10
ORGANIZATION_MEMBER_LIMIT=10
ORGANIZATION_STORAGE_QUOTA_BYTES=5368709120

# Avisos internos de consultas web (API HTTPS de Resend, sin SMTP).
# Sin estas variables completas se guardan las solicitudes y los avisos quedan pendientes.
# RESEND_API_KEY=replace-with-a-private-resend-key
# SERVICE_NOTIFICATION_TO=operator@example.com
# SERVICE_NOTIFICATION_FROM=onboarding@resend.dev
# PUBLIC_APP_URL=http://127.0.0.1:5174
