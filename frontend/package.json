{
  "name": "vista360-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run check:i18n && npm run typecheck && vite build",
    "preview": "vite preview",
    "demo:media": "node scripts/demo-media-server.mjs",
    "test:e2e": "playwright test",
    "generate:api": "../backend/.venv/bin/python ../backend/scripts/export_openapi.py > .openapi.json && openapi-typescript .openapi.json -o src/api/schema.d.ts",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "pannellum": "2.5.7",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsqr": "1.4.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
